<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>ProgrammerShell.Plugins.RealProgrammer</AssemblyName>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <Platforms>AnyCPU;x86</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\ProgrammerShell.Core\ProgrammerShell.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OpenCvSharp4" Version="4.10.0.20240616" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.10.0.20240616" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="MvCameraControl.Net">
      <HintPath>MvCameraControl.Net.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Include="plugin.json" CopyToOutputDirectory="Always" />
  </ItemGroup>

  <Target Name="CopyPluginToApp" AfterTargets="Build" Condition="'$(SolutionDir)' != '' and !$(SolutionDir.Contains('*Undefined*'))">
    <PropertyGroup>
 <_PluginId>real-programmer</_PluginId>
      <_PluginOutDir>$(SolutionDir)src\ProgrammerShell.App\bin\$(Configuration)\net8.0-windows\app\plugins\$(_PluginId)\</_PluginOutDir>
    </PropertyGroup>
    <MakeDir Directories="$(_PluginOutDir)" />
    <ItemGroup>
  <_PluginFiles Include="$(TargetDir)**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_PluginFiles)" DestinationFolder="$(_PluginOutDir)%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
